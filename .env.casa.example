# Produção em casa (docker-compose.casa.yml). Copie para .env.casa e preencha. NUNCA commite o .env.casa.
# Senhas: use só letras e números (vão dentro da URL do banco). Gere com:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_SENHA=
CAMPERO_BACKEND_SENHA=

# Login: projeto Supabase (plano grátis). Só o Auth é usado; banco e arquivos ficam nesta máquina.
SUPABASE_URL=https://<ref>.supabase.co

# Acesso pela internet: tailscale (grátis, sem domínio) ou cloudflare (precisa de domínio).
COMPOSE_PROFILES=tailscale
# Tailscale: Settings > Keys > Generate auth key (reusable). Endereço: https://<TS_NOME>.<tailnet>.ts.net
TS_AUTHKEY=
TS_NOME=serrano
# Cloudflare: Zero Trust > Networks > Tunnels > (seu túnel) > token
TUNNEL_TOKEN=

# Endereços públicos (os do túnel e do Cloudflare Pages)
FRONTEND_URL=https://<painel>.pages.dev
CORS_ORIGENS=["https://<painel>.pages.dev"]

# Fernet (segredos de webhook): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CIFRAGEM=

# Processamento e backup
WORKERS=2
BACKUP_HORA=03
BACKUP_DIAS=14
# Pasta do backup nesta máquina. Aponte para um HD externo ou para a pasta do Google Drive
# para a cópia sair da máquina, ex.: G:/Meu Drive/serrano-backups
BACKUP_DIR=./backups

# E-mail (opcional: alertas, convites, resumo de segunda)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

LOG_LEVEL=INFO
