# Copie para .env e preencha. NUNCA commite o .env.
AMBIENTE=dev

# Banco. Local (docker compose): postgresql://campero_backend:campero_local@localhost:54322/campero
# Supabase: pooler em modo sessão, usuário campero_backend.<project_ref>, porta 5432.
DATABASE_URL=
DB_MODO_POOLER=sessao

# Auth (Supabase). Com chaves assimétricas basta a URL (JWKS).
SUPABASE_URL=
# Só para projetos com o segredo HS256 legado:
SUPABASE_JWT_SECRET=

# JSON: ["http://localhost:5173"]
CORS_ORIGENS=[]
LOG_LEVEL=INFO
LOG_JSON=true

# Testes de integração (superusuário de um PostGIS descartável):
# CAMPERO_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Storage: local (disco, dev/compose) ou supabase (staging/produção).
STORAGE_BACKEND=local
STORAGE_DIR=./data_storage
# Chave secreta do projeto Supabase (sb_secret_...). Só no servidor; nunca no frontend.
SUPABASE_SECRET_KEY=
MAX_UPLOAD_MB=1024

# Worker (fila Postgres)
WORKER_LEASE_S=600
WORKER_HEARTBEAT_S=60

# Notificações e convites
FRONTEND_URL=
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CIFRAGEM=
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Proteção (por instância da API)
LIMITE_POR_MINUTO=600
LIMITE_UPLOADS_POR_MINUTO=120
