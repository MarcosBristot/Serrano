# Copie para .env (que NÃO é versionado) e preencha. Nunca commite chaves.
# Sem SUPABASE_*, o sistema roda 100% local (workspace em disco).
SUPABASE_URL=
# Use a chave service_role SOMENTE no backend (ignora RLS). Nunca no frontend.
SUPABASE_KEY=
# Se definida, todas as rotas exigem o header X-API-Key com este valor.
CAMPERO_API_KEY=
# Onde ficam bruto/limpo/resultados (em Render/Railway use um volume persistente).
CAMPERO_WORKDIR=./data_work
# Pasta Gen4 do pendrive (MasterData.xml + SpatialFiles) para talhões sem Supabase.
CAMPERO_GEN4_DIR=
# Resolução das amostras gravadas no banco, em segundos (1 = todas).
CAMPERO_PERSIST_STEP_S=5
CAMPERO_MAX_UPLOAD_MB=512
